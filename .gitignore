# Challenge data (~379 MB, provided separately; mounted into Docker at runtime)
data/

# Secrets: copy .env.example to .env (API keys live only there)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Backend tests (pytest in backend/tests)
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ML: intermediate datasets are rebuilt by `docker compose run --rm ml`.
# Committed on purpose: trained models (*.joblib), metrics, plots, ASSUMPTIONS.md, demo/cache.json,
# BENCHMARK.md and the small JSON results (hazard curve, regional profile, FNO test).
backend/ml/artifacts/*.parquet
# ...except the historical-weather cache (small; lets the gust curve and benchmark rebuild offline)
!backend/ml/artifacts/weather.parquet

# Runtime logs (incl. the API audit log, backend/logs/audit.jsonl)
backend/logs/
*.log

# Frontend (React + Vite)
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Browser test output (Playwright)
test-results/
playwright-report/
playwright/.cache/

# Docker: personal overrides
docker-compose.override.yml

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
